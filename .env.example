FASTAPI_APP_NAME=FastAPI Login API
FASTAPI_DEBUG=true
FASTAPI_API_V1_PREFIX=/api/v1
# Format: mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# XAMPP commonly uses root with an empty password during local development:
FASTAPI_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/fastapi_db
FASTAPI_JWT_SECRET_KEY=replace-with-a-long-random-secret
FASTAPI_JWT_ALGORITHM=HS256
FASTAPI_ACCESS_TOKEN_EXPIRE_MINUTES=30
